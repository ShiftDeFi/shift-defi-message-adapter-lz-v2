# Change * to network prefix (ETH, ARB, etc.)
*_RPC_URL=
ETHERSCAN_API_KEY=

# Deployer/signer is supplied on the CLI, e.g. `forge script ... --account <keystore-name>`.
# Its address is deduced automatically and used as the temporary owner during deployment
# so the adapter can be configured within a single broadcast.

############################################################
##########################  ROLES ##########################
############################################################

# Common admin roles
OWNER=
NONCE_MANAGER_ROLE=

ENDPOINT=
MESSAGE_ROUTER=

############################################################
##########################  LAYERZERO CONFIG ##########################
############################################################

# LayerZero send/receive libraries on this chain
SEND_LIBRARY=
RECEIVE_LIBRARY=

# Remote chain being connected to
REMOTE_EID=
REMOTE_CHAIN_ID=

############################################################
##########################  PEERING (ConfigurePeer.s.sol) ##########################
############################################################

# Run after ShiftOApp is deployed on BOTH chains. SHIFT_OAPP is this chain's
# deployed adapter address; REMOTE_PEER is the other chain's deployed adapter
# address. Sets the peer link and transfers ownership to OWNER.
SHIFT_OAPP=
REMOTE_PEER=
